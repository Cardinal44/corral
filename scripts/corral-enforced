#!/usr/bin/env bash
set -euo pipefail
here="$(dirname "$0")"
# In a release archive, corral is next to this script.
if [ -z "${CORRAL_BIN:-}" ]; then
  if [ -x "$here/corral" ]; then CORRAL_BIN="$here/corral"; else CORRAL_BIN="$here/../build/corral"; fi
fi
exec systemd-run --user --scope -p Delegate=yes --quiet --collect -- \
  "$CORRAL_BIN" --cgroup-mode=enforced "$@"
